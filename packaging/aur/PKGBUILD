# Maintainer: wiktorekdev <https://github.com/wiktorekdev/plugover>
# Filled in by scripts/build.sh; publish dist/aur/ to the AUR (makepkg --printsrcinfo > .SRCINFO).
pkgname=plugover-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc='Use USB wheels, pedals and controllers on the PC you stream games from (USB/IP)'
arch=('x86_64' 'aarch64' 'armv7h')
url='https://github.com/wiktorekdev/plugover'
license=('MIT')
depends=('systemd')
provides=('plugover')
conflicts=('plugover')
install=plugover.install
_url="$url/releases/download/v$pkgver"
source=("LICENSE::https://raw.githubusercontent.com/wiktorekdev/plugover/v$pkgver/LICENSE")
source_x86_64=("plugover-$pkgver-x86_64::$_url/plugover-$pkgver-linux-x86_64")
source_aarch64=("plugover-$pkgver-aarch64::$_url/plugover-$pkgver-linux-aarch64")
source_armv7h=("plugover-$pkgver-armv7h::$_url/plugover-$pkgver-linux-armv7")
sha256sums=('__SHA_LICENSE__')
sha256sums_x86_64=('__SHA_X86_64__')
sha256sums_aarch64=('__SHA_AARCH64__')
sha256sums_armv7h=('__SHA_ARMV7__')

package() {
    install -Dm755 "plugover-$pkgver-$CARCH" "$pkgdir/usr/bin/plugover"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
