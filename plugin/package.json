{
	"name": "punktfunk-plugin-plugover",
	"version": "0.3.0",
	"description": "punktfunk plugin for Plugover: connects USB devices from a relay while a stream runs.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"files": ["dist"],
	"scripts": {
		"build": "bun run build:server && bun run build:ui",
		"build:server": "bun build src/index.ts --target=bun --outdir dist --external effect --external '@punktfunk/*'",
		"build:ui": "vite build ui",
		"typecheck": "tsc --noEmit -p . && tsc --noEmit -p ui"
	},
	"dependencies": {
		"@punktfunk/host": "^0.2.0"
	},
	"punktfunk": {
		"schema": 1,
		"id": "plugover",
		"writes": ["~/.local/state/plugover"],
		"network": false
	},
	"devDependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@punktfunk/plugin-kit": "0.13.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@unom/ui": "^0.10.0",
		"@vitejs/plugin-react": "^6.1.2",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.9.3",
		"vite": "^8.3.5"
	}
}
